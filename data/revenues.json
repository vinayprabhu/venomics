    "bee": {
      "drug": "Honeybee venom allergenic extract",
      "display": "≈$9–21M/yr",
      "caption": "Modeled US · 2021 prices",
      "status": "illustrative_annual_list_price_model",
      "lifetimeRevenueUSD": null,
      "documentedRevenueUSD": null,
      "estimatedAnnualRangeUSD": [
        8805736,
        20729348
      ],
      "currency": "USD at 2021 manufacturer list prices",
      "period": "Illustrative annual scenario; inputs from 2018–2023",
      "scope": "US honeybee-venom immunotherapy extract category, modeled at HollisterStier 2021 list prices. Not a manufacturer-specific historical revenue total.",
      "note": "This is a scenario for annual gross extract spending, not disclosed net sales or lifetime revenue. It combines the manufacturer’s 2018 estimate of 50,000–75,000 US VIT patients, honeybee treatment shares from a US military-beneficiary cohort, monthly/four-week maintenance, and a 2021 price list. Applying cohort shares nationally and holding inputs together is an explicit modeling assumption. Discounts, build-up, diagnostic use, wastage, high-dose treatment, historical uptake and later price changes are not measured here. The range is not a confidence interval. Complete lifetime revenue remains unavailable.",
      "model": {
        "formula": "US VIT patients × honeybee-treatment share × annual 100-microgram doses × USD per dose",
        "low": {
          "patients": 50000,
          "honeybeeShare": 0.5017513134851138,
          "annualDoses": 12,
          "usdPerDose": 29.25,
          "resultUSD": 8805735.551663747
        },
        "high": {
          "patients": 75000,
          "honeybeeShare": 0.6521739130434783,
          "annualDoses": 13,
          "usdPerDose": 32.6,
          "resultUSD": 20729347.82608696
        }
      },
      "annualFigures": [],
      "sources": [
        {
          "label": "HollisterStier-funded 2018 reimbursement paper: estimated US VIT patient count",
          "url": "https://www.hsally.com/wp-content/uploads/2019/05/Venom-Immunotherapy-Reimbursement.pdf",
          "fact": "The manufacturer reports an internal estimate of 50,000–75,000 patients treated with VIT; it is attributed to Constable, personal communication, 2018. This is not an audited census. The paper describes approximately four-week maintenance intervals."
        },
        {
          "label": "HollisterStier 2021 price list, effective 1 July 2021",
          "url": "https://www.hsally.com/wp-content/uploads/2021/07/2021-Price-List-HS28.pdf",
          "fact": "Honey Bee Venom: item 6781PG, five doses for $163; item 6781UX, twelve doses for $351. Thus list cost is $32.60 or $29.25 per labeled dose."
        },
        {
          "label": "McMurray et al., 2025: original US Tricare prescription study",
          "url": "https://www.frontiersin.org/journals/allergy/articles/10.3389/falgy.2025.1570123/full",
          "fact": "Among 1,911 current beneficiaries with prescription histories, 878 had fire-ant IT and 109 had both fire-ant and flying-Hymenoptera IT, giving 1,142 with flying-Hymenoptera IT. Honeybee appeared in 573 histories (50.18% of 1,142). In 2023, 75 of 115 new flying-Hymenoptera patients received honeybee extract (65.22%). These are treatment-pattern anchors, not a nationally representative market census."
        },
        {
          "label": "DailyMed: Jubilant HollisterStier multidose honeybee-venom label",
          "url": "https://www.dailymed.nlm.nih.gov/dailymed/drugInfo.cfm?setid=1e9fb453-91a7-4072-bd73-d7209ba50697",
          "fact": "Maintenance is 100 micrograms per venom, approximately monthly after escalation; honeybee marketing start is 16 October 1979."
        },
        {
          "label": "Jubilant Pharmova May 2024 investor release",
          "url": "https://www.jubilantpharmova.com/Uploads/image/2702imguf_STXPressRelease.pdf",
          "fact": "Company describes itself as sole US venom supplier, while Allergy Immunotherapy segment revenue includes other allergenic extracts. It does not disclose honeybee-specific net sales."
        }
      ]
